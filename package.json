{
  "name": "spotrun",
  "displayName": "Spot Run",
  "description": "Run any Python function on the spot. A language model invents the inputs, external dependencies become lazy fakes, and you step through the recorded run in the editor.",
  "version": "0.7.1",
  "publisher": "kareemlsd",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Kareemlsd/spotrun.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "AI"
  ],
  "keywords": [
    "python",
    "debug",
    "copilot",
    "language model",
    "trace"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "spotrun.run",
        "title": "Run Function at Cursor",
        "category": "Spot Run",
        "icon": "$(play)"
      },
      {
        "command": "spotrun.regenerate",
        "title": "Run with New Inputs",
        "category": "Spot Run",
        "icon": "$(refresh)"
      },
      {
        "command": "spotrun.stepOver",
        "title": "Step Over",
        "category": "Spot Run",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "spotrun.stepInto",
        "title": "Step Into",
        "category": "Spot Run",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "spotrun.stepOut",
        "title": "Step Out",
        "category": "Spot Run",
        "icon": "$(debug-step-out)"
      },
      {
        "command": "spotrun.stepBack",
        "title": "Step Back",
        "category": "Spot Run",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "spotrun.restart",
        "title": "Go to First Step",
        "category": "Spot Run",
        "icon": "$(debug-restart)"
      },
      {
        "command": "spotrun.toEnd",
        "title": "Go to End",
        "category": "Spot Run",
        "icon": "$(debug-continue)"
      },
      {
        "command": "spotrun.stop",
        "title": "Stop",
        "category": "Spot Run",
        "icon": "$(debug-stop)"
      },
      {
        "command": "spotrun.debug",
        "title": "Open This Run in the Debugger",
        "category": "Spot Run",
        "icon": "$(debug-alt)"
      },
      {
        "command": "spotrun.editValue",
        "title": "Edit and Pin Value",
        "category": "Spot Run",
        "icon": "$(edit)"
      },
      {
        "command": "spotrun.unpin",
        "title": "Unpin Value",
        "category": "Spot Run",
        "icon": "$(pinned)"
      },
      {
        "command": "spotrun.forget",
        "title": "Forget Inputs and Pins for This Function",
        "category": "Spot Run",
        "icon": "$(trash)"
      },
      {
        "command": "spotrun.selectModel",
        "title": "Select Language Model",
        "category": "Spot Run"
      },
      {
        "command": "spotrun.showLog",
        "title": "Show Log",
        "category": "Spot Run"
      },
      {
        "command": "spotrun.describe",
        "title": "Describe Inputs for Function at Cursor",
        "category": "Spot Run",
        "icon": "$(comment)"
      },
      {
        "command": "spotrun.submitInstruction",
        "title": "Run with These Inputs",
        "category": "Spot Run"
      },
      {
        "command": "spotrun.clearInstruction",
        "title": "Clear Description and Close",
        "category": "Spot Run",
        "icon": "$(clear-all)"
      },
      {
        "command": "spotrun.digDeep",
        "title": "Dig Deep: Read the Codebase for Better Inputs",
        "category": "Spot Run",
        "icon": "$(telescope)"
      },
      {
        "command": "spotrun.edgeCases",
        "title": "Edge Cases",
        "category": "Spot Run",
        "icon": "$(beaker)"
      },
      {
        "command": "spotrun.nextEdgeCase",
        "title": "Next Edge Case",
        "category": "Spot Run"
      },
      {
        "command": "spotrun.previousEdgeCase",
        "title": "Previous Edge Case",
        "category": "Spot Run"
      },
      {
        "command": "spotrun.showEdgeCase",
        "title": "Step Through Edge Case",
        "category": "Spot Run"
      },
      {
        "command": "spotrun.writeTests",
        "title": "Write Tests from These Runs",
        "category": "Spot Run",
        "icon": "$(checklist)"
      },
      {
        "command": "spotrun.selfCheck",
        "title": "Self-Check (Interpreter, Guard, Sandbox, Model)",
        "category": "Spot Run"
      }
    ],
    "keybindings": [
      {
        "command": "spotrun.run",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == python"
      },
      {
        "command": "spotrun.describe",
        "key": "ctrl+alt+shift+enter",
        "mac": "cmd+alt+shift+enter",
        "when": "editorTextFocus && editorLangId == python"
      },
      {
        "command": "spotrun.stepOver",
        "key": "f10",
        "when": "spotrun.replayActive && !inDebugMode"
      },
      {
        "command": "spotrun.stepInto",
        "key": "f11",
        "when": "spotrun.replayActive && !inDebugMode"
      },
      {
        "command": "spotrun.stepOut",
        "key": "shift+f11",
        "when": "spotrun.replayActive && !inDebugMode"
      },
      {
        "command": "spotrun.stepBack",
        "key": "shift+f10",
        "when": "spotrun.replayActive && !inDebugMode"
      },
      {
        "command": "spotrun.stop",
        "key": "escape",
        "when": "(spotrun.replayActive || spotrun.waitingForSave) && editorTextFocus && !inDebugMode && !suggestWidgetVisible && !findWidgetVisible && !parameterHintsVisible && !inSnippetMode && !editorHasSelection && !editorHasMultipleSelections && !renameInputVisible && !inlineSuggestionVisible && !notificationToastsVisible && !codeActionMenuVisible"
      },
      {
        "command": "spotrun.nextEdgeCase",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "spotrun.replayActive && !inDebugMode"
      },
      {
        "command": "spotrun.previousEdgeCase",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "spotrun.replayActive && !inDebugMode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "spotrun.editValue",
          "when": "false"
        },
        {
          "command": "spotrun.unpin",
          "when": "false"
        },
        {
          "command": "spotrun.stepOver",
          "when": "spotrun.replayActive"
        },
        {
          "command": "spotrun.stepInto",
          "when": "spotrun.replayActive"
        },
        {
          "command": "spotrun.stepOut",
          "when": "spotrun.replayActive"
        },
        {
          "command": "spotrun.stepBack",
          "when": "spotrun.replayActive"
        },
        {
          "command": "spotrun.restart",
          "when": "spotrun.replayActive"
        },
        {
          "command": "spotrun.toEnd",
          "when": "spotrun.replayActive"
        },
        {
          "command": "spotrun.debug",
          "when": "spotrun.hasResult"
        },
        {
          "command": "spotrun.regenerate",
          "when": "editorLangId == python || spotrun.hasResult"
        },
        {
          "command": "spotrun.submitInstruction",
          "when": "false"
        },
        {
          "command": "spotrun.clearInstruction",
          "when": "false"
        },
        {
          "command": "spotrun.showEdgeCase",
          "when": "false"
        },
        {
          "command": "spotrun.writeTests",
          "when": "spotrun.hasResult"
        }
      ],
      "editor/context": [
        {
          "command": "spotrun.run",
          "when": "editorLangId == python",
          "group": "navigation@90"
        },
        {
          "command": "spotrun.describe",
          "when": "editorLangId == python",
          "group": "navigation@91"
        },
        {
          "command": "spotrun.digDeep",
          "when": "editorLangId == python",
          "group": "navigation@92"
        },
        {
          "command": "spotrun.edgeCases",
          "when": "editorLangId == python",
          "group": "navigation@93"
        }
      ],
      "editor/title": [
        {
          "command": "spotrun.stepBack",
          "when": "spotrun.replayActive && editorLangId == python",
          "group": "navigation@1"
        },
        {
          "command": "spotrun.stepOver",
          "when": "spotrun.replayActive && editorLangId == python",
          "group": "navigation@2"
        },
        {
          "command": "spotrun.stepInto",
          "when": "spotrun.replayActive && editorLangId == python",
          "group": "navigation@3"
        },
        {
          "command": "spotrun.stepOut",
          "when": "spotrun.replayActive && editorLangId == python",
          "group": "navigation@4"
        },
        {
          "command": "spotrun.regenerate",
          "when": "spotrun.replayActive && editorLangId == python",
          "group": "navigation@5"
        },
        {
          "command": "spotrun.stop",
          "when": "spotrun.replayActive && editorLangId == python",
          "group": "navigation@6"
        }
      ],
      "view/title": [
        {
          "command": "spotrun.edgeCases",
          "when": "view == spotrun.panel && spotrun.hasResult",
          "group": "navigation@0"
        },
        {
          "command": "spotrun.writeTests",
          "when": "view == spotrun.panel && spotrun.hasResult",
          "group": "navigation@0"
        },
        {
          "command": "spotrun.regenerate",
          "when": "view == spotrun.panel && spotrun.hasResult",
          "group": "navigation@1"
        },
        {
          "command": "spotrun.debug",
          "when": "view == spotrun.panel && spotrun.hasResult",
          "group": "navigation@2"
        },
        {
          "command": "spotrun.forget",
          "when": "view == spotrun.panel && spotrun.hasResult",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "spotrun.editValue",
          "when": "view == spotrun.panel && viewItem =~ /^spotrun\\.(arg|fake)/",
          "group": "inline@1"
        },
        {
          "command": "spotrun.unpin",
          "when": "view == spotrun.panel && viewItem =~ /^spotrun\\.(arg|fake)\\.pinned$/",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "spotrun.submitInstruction",
          "group": "inline",
          "when": "commentController == spotrun"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "spotrun.clearInstruction",
          "group": "navigation",
          "when": "commentController == spotrun"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "spotrun.panel",
          "name": "Spot Run",
          "icon": "$(play-circle)",
          "when": "spotrun.hasResult",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Spot Run",
      "properties": {
        "spotrun.useLanguageModel": {
          "type": "boolean",
          "default": true,
          "description": "Ask a language model (GitHub Copilot or any other provider registered in VS Code) for realistic inputs and fake return values. When off, or when no model is available, built-in sample values based on names and type hints are used."
        },
        "spotrun.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model to use, matched against the model's family, id or name, ignoring case and punctuation. Leave empty to pick the smallest fast model that is available, Copilot first. The easiest way to set this is the model entry in the status bar or the command **Spot Run: Select Language Model**."
        },
        "spotrun.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter used to run functions. Leave empty to use the interpreter selected in the Python extension."
        },
        "spotrun.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a Spot Run action above each function."
        },
        "spotrun.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "file",
            "function"
          ],
          "enumDescriptions": [
            "Record the function and every function it calls in your workspace.",
            "Record the function and functions it calls in the same file.",
            "Record only the function itself."
          ],
          "default": "workspace",
          "description": "Which code is recorded so that you can step into it."
        },
        "spotrun.startAt": {
          "type": "string",
          "enum": [
            "first",
            "end"
          ],
          "enumDescriptions": [
            "Stop on the first line, like a breakpoint at the top of the function.",
            "Show the finished run with every value filled in."
          ],
          "default": "first",
          "description": "Where the replay starts after a run. Runs that raise always start at the failing line."
        },
        "spotrun.timeoutSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Stop a run that takes longer than this. Time spent waiting for the language model does not count."
        },
        "spotrun.maxModelCalls": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Upper bound on language model requests for fake values in one run. Further fakes use built-in sample values."
        },
        "spotrun.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Save the file before running. The function is imported from disk, so unsaved edits are otherwise ignored."
        },
        "spotrun.digDeep.always": {
          "type": "boolean",
          "default": false,
          "description": "Let the model read through the workspace every time it generates inputs, instead of only when you choose Dig deep. Gives better inputs for complicated functions and uses several model requests per generation."
        },
        "spotrun.digDeep.maxLookups": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 30,
          "description": "How many searches and file reads the model may make in one Dig deep. Each lookup is one more model request."
        },
        "spotrun.extraPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders to add to the import path when a function is run, absolute or relative to the workspace folder. Needed only for your own modules that live outside the workspace: modules anywhere inside it are found automatically, and `python.analysis.extraPaths` and `PYTHONPATH` from the workspace `.env` file are honoured too."
        },
        "spotrun.edgeCases.max": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 25,
          "description": "Upper limit on the number of edge cases the model may propose for a function. Finding them is one model request; each case is then run once."
        },
        "spotrun.sandbox": {
          "type": "string",
          "enum": [
            "auto",
            "required",
            "off"
          ],
          "enumDescriptions": [
            "Run inside an operating-system sandbox when one works on this machine (bubblewrap on Linux, sandbox-exec on macOS); otherwise use the in-process guard alone.",
            "Refuse to run anything unless the operating-system sandbox is active.",
            "Use the in-process guard alone."
          ],
          "default": "auto",
          "markdownDescription": "Operating-system containment for the function being run. Inside the sandbox there is no network and files can only be written to a scratch folder, whatever the code does. Windows has no supported sandbox, so `auto` uses the guard alone there and `required` refuses to run."
        },
        "spotrun.rerunOnSave": {
          "type": "boolean",
          "default": true,
          "description": "After an edit ends a replay, run the same function (or edge case) again with the same inputs when the file is saved."
        },
        "spotrun.showWalkthroughOnInstall": {
          "type": "boolean",
          "default": true,
          "description": "Open the Get started walkthrough once after the extension is installed."
        }
      }
    },
    "configurationDefaults": {
      "comments.openView": "never"
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get started with Spot Run",
        "description": "Run a Python function on the spot with invented inputs, and step through it.",
        "steps": [
          {
            "id": "run",
            "title": "Run a function",
            "description": "Open a Python file, put the cursor inside a function and press Ctrl+Alt+Enter (Cmd+Alt+Enter on macOS), or click **Spot Run** above the def. A language model invents the inputs; calls to databases, HTTP and files are replaced by fakes.\n[Run Function at Cursor](command:spotrun.run)",
            "media": {
              "image": "docs/media/run-and-step.gif",
              "altText": "A function that calls an HTTP API is run and stepped through"
            },
            "completionEvents": [
              "onCommand:spotrun.run"
            ]
          },
          {
            "id": "step",
            "title": "Step through the recording",
            "description": "F10 steps over, F11 steps into your own functions, Shift+F11 steps out, Shift+F10 steps back. Values appear next to the lines that produced them. Click the status bar entry to see inputs, invented values and intercepted calls.\n[Show the Panel](command:spotrun.showPanel)",
            "media": {
              "image": "docs/media/panel.png",
              "altText": "The Spot Run panel beside a finished run"
            },
            "completionEvents": [
              "onCommand:spotrun.stepOver",
              "onCommand:spotrun.showPanel"
            ]
          },
          {
            "id": "describe",
            "title": "Describe the inputs",
            "description": "Click **Describe inputs** above the function and say what the data should look like. Follow-ups refine the previous inputs.\n[Describe Inputs](command:spotrun.describe)",
            "media": {
              "image": "docs/media/describe-inputs.gif",
              "altText": "Describing inputs in a conversation under the function"
            },
            "completionEvents": [
              "onCommand:spotrun.describe"
            ]
          },
          {
            "id": "cases",
            "title": "Find the edge cases",
            "description": "**Edge cases** proposes the situations this code treats differently, runs each once and lists what returned and what raised. Pick one to step through it.\n[Edge Cases](command:spotrun.edgeCases)",
            "media": {
              "image": "docs/media/edge-cases.gif",
              "altText": "A list of edge cases with their outcomes"
            },
            "completionEvents": [
              "onCommand:spotrun.edgeCases"
            ]
          },
          {
            "id": "tests",
            "title": "Write tests from the runs",
            "description": "When the runs look right, **Write tests** turns them into test functions in your codebase, in the file where your project keeps its tests, and checks that they pass.\n[Write Tests](command:spotrun.writeTests)",
            "media": {
              "image": "docs/media/write-tests.gif",
              "altText": "Tests written beside the function"
            },
            "completionEvents": [
              "onCommand:spotrun.writeTests"
            ]
          },
          {
            "id": "check",
            "title": "Check your setup",
            "description": "The self-check verifies the interpreter, the guard, the operating-system sandbox and your language model on this machine.\n[Run the Self-Check](command:spotrun.selfCheck)\n[Select Language Model](command:spotrun.selectModel)",
            "media": {
              "image": "docs/media/panel.png",
              "altText": "The panel shows which containment was active"
            },
            "completionEvents": [
              "onCommand:spotrun.selfCheck"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "tsc -p tsconfig.test.json && node --test out/test/core.test.js",
    "test:python": "python3 -m pytest tests -q",
    "test": "npm run typecheck && npm run test:unit && npm run test:python",
    "package": "npm run build -- --production && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --production",
    "test:e2e": "node e2e/run.mjs",
    "demo": "node e2e/demo.mjs && python3 docs/build_media.py"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Kareemlsd/spotrun/issues"
  },
  "homepage": "https://github.com/Kareemlsd/spotrun#readme"
}
